# Local config — account list, settings, no secrets (those live in
# the OS keyring — see internal/secrets). Still excluded since it's
# machine-specific state, not something to version.
config.json
*.token
.env

# Go build output — except the checked-in source config below
/build/*
!/build/appicon.png
!/build/windows/
/build/windows/*
!/build/windows/icon.ico
!/build/windows/icon-error.ico
!/build/windows/info.json
!/build/windows/wails.exe.manifest
!/build/windows/installer/
/build/windows/installer/*
!/build/windows/installer/project.nsi
*.exe
*.test

# Wails frontend build output
frontend/dist/
frontend/node_modules/

# OS cruft
.DS_Store
Thumbs.db

# Local AI-assistant / testing / debug tooling — never goes to GitHub
.claude/
